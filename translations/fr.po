#: rouen_iframe_consent.info.yml:1
#: rouen_iframe_consent.links.menu.yml:2
#: rouen_iframe_consent.routing.yml:5
msgid "Rouen Iframe Consent"
msgstr "Consentement aux iframes de Rouen"

#: rouen_iframe_consent.info.yml:3
msgid "Displays privacy-preserving consent placeholders before loading third-party iframes."
msgstr "Affiche des écrans de consentement respectueux de la vie privée avant le chargement d’iframes tierces."

#: rouen_iframe_consent.info.yml:4
msgid "Custom"
msgstr "Personnalisé"

#: rouen_iframe_consent.permissions.yml:2
msgid "Administer Rouen Iframe Consent"
msgstr "Administrer Consentement aux iframes de Rouen"

#: rouen_iframe_consent.permissions.yml:3
msgid "Configure the iframe consent allowlist and fallback image."
msgstr "Configurer la liste des sites autorisés et l’image de remplacement pour le consentement aux iframes."

#: rouen_iframe_consent.links.menu.yml:3
msgid "Configure iframe consent placeholders and trusted sites."
msgstr "Configurer les écrans de consentement des iframes et les sites de confiance."

#: config/schema/rouen_iframe_consent.schema.yml:3
msgid "Rouen Iframe Consent settings"
msgstr "Paramètres de Consentement aux iframes de Rouen"

#: config/schema/rouen_iframe_consent.schema.yml:7
msgid "Trusted hosts"
msgstr "Hôtes de confiance"

#: config/schema/rouen_iframe_consent.schema.yml:10
msgid "Host"
msgstr "Hôte"

#: config/schema/rouen_iframe_consent.schema.yml:13
msgid "Fallback image file ID"
msgstr "Identifiant du fichier de l’image de remplacement"

#: src/Plugin/QueueWorker/ThumbnailQueueWorker.php:19
msgid "Rouen Iframe Consent thumbnail retrieval"
msgstr "Récupération des miniatures de Consentement aux iframes de Rouen"

#: src/Plugin/Field/FieldFormatter/RouenIframeConsentFormatter.php:26
msgid "Iframe with individual consent"
msgstr "Iframe avec consentement individuel"

#: src/Plugin/Field/FieldFormatter/RouenIframeConsentFormatter.php:107
msgid "External content from @provider"
msgstr "Contenu externe provenant de @provider"

#: config/install/rouen_iframe_consent.settings.yml
msgid "This content is hosted by @provider. Loading it may allow this service to store cookies on your device."
msgstr "Ce contenu est hébergé par @provider. Son chargement peut autoriser ce service à enregistrer des cookies sur votre appareil."

#: config/install/rouen_iframe_consent.settings.yml
msgid "I accept"
msgstr "J’accepte"

#: src/Form/SettingsForm.php:94
msgid "Trusted sites"
msgstr "Sites de confiance"

#: src/Form/SettingsForm.php:96
msgid "Enter one host name per line, without a path (for example, media.example.org). Iframes from these hosts and their subdomains are loaded without asking for consent."
msgstr "Saisissez un nom d’hôte par ligne, sans chemin (par exemple media.example.org). Les iframes provenant de ces hôtes et de leurs sous-domaines sont chargées sans demander de consentement."

#: src/Form/SettingsForm.php:105
msgid "Generic preview image"
msgstr "Image d’aperçu générique"

#: src/Form/SettingsForm.php:107
msgid "Used when the external service does not expose an oEmbed thumbnail. Leave empty to use the image supplied with the module."
msgstr "Utilisée lorsque le service externe ne fournit pas de miniature oEmbed. Laissez ce champ vide pour utiliser l’image fournie avec le module."

#: src/Form/SettingsForm.php:144
msgid "%host is not a valid host name."
msgstr "%host n’est pas un nom d’hôte valide."

#: config/schema/rouen_iframe_consent.schema.yml
#: src/Form/SettingsForm.php
msgid "Consent message"
msgstr "Message de consentement"

#: src/Form/SettingsForm.php
msgid "Use @provider where the external service name should appear."
msgstr "Utilisez @provider à l’emplacement où le nom du service externe doit apparaître."

#: config/schema/rouen_iframe_consent.schema.yml
#: src/Form/SettingsForm.php
msgid "Consent button label"
msgstr "Libellé du bouton de consentement"

#: config/schema/rouen_iframe_consent.schema.yml
#: src/Form/SettingsForm.php
msgid "Default iframe width"
msgstr "Largeur par défaut de l’iframe"

#: src/Form/SettingsForm.php
msgid "Width in pixels used when an iframe has no valid width."
msgstr "Largeur en pixels utilisée lorsqu’une iframe n’a pas de largeur valide."

#: config/schema/rouen_iframe_consent.schema.yml
#: src/Form/SettingsForm.php
msgid "Default iframe height"
msgstr "Hauteur par défaut de l’iframe"

#: src/Form/SettingsForm.php
msgid "Height in pixels used when an iframe has no valid height."
msgstr "Hauteur en pixels utilisée lorsqu’une iframe n’a pas de hauteur valide."

#: src/Form/SettingsForm.php
msgid "Remote thumbnail settings"
msgstr "Paramètres des miniatures distantes"

#: config/schema/rouen_iframe_consent.schema.yml
#: src/Form/SettingsForm.php
msgid "Maximum remote thumbnail size"
msgstr "Taille maximale des miniatures distantes"

#: src/Form/SettingsForm.php
msgid "Maximum downloaded file size in bytes."
msgstr "Taille maximale du fichier téléchargé en octets."

#: config/schema/rouen_iframe_consent.schema.yml
#: src/Form/SettingsForm.php
msgid "Thumbnail connection timeout"
msgstr "Délai d’attente de connexion de la miniature"

#: src/Form/SettingsForm.php
msgid "Maximum time in seconds allowed to establish the connection."
msgstr "Durée maximale en secondes autorisée pour établir la connexion."

#: config/schema/rouen_iframe_consent.schema.yml
#: src/Form/SettingsForm.php
msgid "Thumbnail request timeout"
msgstr "Délai d’attente de la requête de miniature"

#: src/Form/SettingsForm.php
msgid "Maximum total time in seconds allowed for the request."
msgstr "Durée totale maximale en secondes autorisée pour la requête."

#: config/schema/rouen_iframe_consent.schema.yml
#: src/Form/SettingsForm.php
msgid "Maximum thumbnail redirects"
msgstr "Nombre maximal de redirections de miniature"

#: src/Form/SettingsForm.php
msgid "Maximum number of HTTP redirects followed for one thumbnail."
msgstr "Nombre maximal de redirections HTTP suivies pour une miniature."

#: src/Form/SettingsForm.php
msgid "This field is required."
msgstr "Ce champ est obligatoire."
