{#
/**
 * @file
 * Consent placeholder displayed before a third-party iframe is loaded.
 */
#}
<div class="rouen-iframe-consent" style="--ric-width: {{ width }}px; --ric-ratio: {{ width }} / {{ height }};">
  {% if thumbnail_url %}
    <img class="rouen-iframe-consent__thumbnail" src="{{ thumbnail_url }}" alt="">
  {% endif %}
  <div class="rouen-iframe-consent__overlay">
    <p class="rouen-iframe-consent__message">{{ message }}</p>
    <button
      class="rouen-iframe-consent__accept"
      type="button"
      data-rouen-iframe-consent
      data-iframe-attributes="{{ iframe_attributes }}"
    >{{ button_label }}</button>
  </div>
</div>
