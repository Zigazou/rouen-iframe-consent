{#
/**
 * @file
 * Consent placeholder displayed before third-party content is loaded.
 */
#}
<div
  class="rouen-iframe-consent rouen-iframe-consent--{{ embed_type }}"
  style="--ric-width: {{ width }}; --ric-height: {{ height }}px;"
  {% if embed_type == 'blockquote' %}
    data-rouen-embed-container
    data-script-attributes="{{ script_attributes }}"
    {% if autoload %}data-rouen-embed-autoload{% endif %}
  {% endif %}
>
  {% if preview_html %}
    <div class="rouen-iframe-consent__preview">{{ preview_html }}</div>
  {% endif %}
  {% if thumbnail_url %}
    <img
      class="rouen-iframe-consent__thumbnail"
      src="{{ thumbnail_url }}"
      alt=""
    >
  {% endif %}
  {% if not autoload %}
    <div class="rouen-iframe-consent__overlay">
      <p class="rouen-iframe-consent__message">{{ message }}</p>
      <button
        class="rouen-iframe-consent__accept"
        type="button"
        data-rouen-iframe-consent
        data-embed-type="{{ embed_type }}"
        {% if iframe_attributes %}
          data-iframe-attributes="{{ iframe_attributes }}"
        {% endif %}
      >{{ button_label }}</button>
    </div>
  {% endif %}
</div>
